-- SPEED X | Rayfield UI Version

-- UI LIB
local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

-- SERVICES
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local char = player.Character or player.CharacterAdded:Wait()
player.CharacterAdded:Connect(function(c) char = c end)

-- STATE
local spinOn, speedOn, runOn, flyOn = false,false,false,false
local spinPower, vehicleSpeed, runSpeed, flySpeed = 200,120,32,80
local spinAV, speedBV, flyBV, flyBG

-- WINDOW
local Window = Rayfield:CreateWindow({
   Name = "⚡ Speed X",
   LoadingTitle = "Speed X",
   LoadingSubtitle = "Rayfield UI",
   ConfigurationSaving = { Enabled = false }
})

-- ================= VEHICLE =================
local VehicleTab = Window:CreateTab("🚗 Vehicle")

VehicleTab:CreateToggle({
   Name = "Spin Vehicle",
   Callback = function(v)
      spinOn = v
   end
})

VehicleTab:CreateSlider({
   Name = "Spin Power",
   Range = {1,1000},
   Increment = 10,
   CurrentValue = spinPower,
   Callback = function(v)
      spinPower = v
   end
})

VehicleTab:CreateToggle({
   Name = "Vehicle Speed",
   Callback = function(v)
      speedOn = v
   end
})

VehicleTab:CreateSlider({
   Name = "Vehicle Speed Power",
   Range = {20,500},
   Increment = 10,
   CurrentValue = vehicleSpeed,
   Callback = function(v)
      vehicleSpeed = v
   end
})

-- VEHICLE LOOP
RunService.Stepped:Connect(function()
   local hum = char and char:FindFirstChildOfClass("Humanoid")
   local seat = hum and hum.SeatPart
   if not seat then
      if spinAV then spinAV:Destroy() spinAV=nil end
      if speedBV then speedBV:Destroy() speedBV=nil end
      return
   end

   if spinOn then
      if not spinAV then
         spinAV = Instance.new("BodyAngularVelocity",seat)
         spinAV.MaxTorque = Vector3.new(0,math.huge,0)
      end
      spinAV.AngularVelocity = Vector3.new(0,spinPower,0)
   elseif spinAV then spinAV:Destroy() spinAV=nil end

   if speedOn then
      if not speedBV then
         speedBV = Instance.new("BodyVelocity",seat)
         speedBV.MaxForce = Vector3.new(math.huge,0,math.huge)
      end
      speedBV.Velocity = seat.CFrame.LookVector * vehicleSpeed
   elseif speedBV then speedBV:Destroy() speedBV=nil end
end)

-- ================= MOVEMENT =================
local MoveTab = Window:CreateTab("🏃 Movement")

MoveTab:CreateToggle({
   Name = "Run Fast",
   Callback = function(v)
      runOn = v
   end
})

MoveTab:CreateSlider({
   Name = "Run Speed",
   Range = {16,100},
   Increment = 1,
   CurrentValue = runSpeed,
   Callback = function(v)
      runSpeed = v
   end
})

RunService.Heartbeat:Connect(function()
   local hum = char and char:FindFirstChildOfClass("Humanoid")
   if hum then
      hum.WalkSpeed = runOn and runSpeed or 16
   end
end)

-- FLY
local function startFly()
   local hrp = char:WaitForChild("HumanoidRootPart")
   flyBV = Instance.new("BodyVelocity",hrp)
   flyBV.MaxForce = Vector3.new(math.huge,math.huge,math.huge)

   flyBG = Instance.new("BodyGyro",hrp)
   flyBG.MaxTorque = Vector3.new(math.huge,math.huge,math.huge)

   RunService:BindToRenderStep("Fly",0,function()
      local cam = workspace.CurrentCamera
      flyBG.CFrame = cam.CFrame
      flyBV.Velocity = cam.CFrame.LookVector * flySpeed
   end)
end

local function stopFly()
   RunService:UnbindFromRenderStep("Fly")
   if flyBV then flyBV:Destroy() flyBV=nil end
   if flyBG then flyBG:Destroy() flyBG=nil end
end

MoveTab:CreateToggle({
   Name = "Fly",
   Callback = function(v)
      flyOn = v
      if v then startFly() else stopFly() end
   end
})

MoveTab:CreateSlider({
   Name = "Fly Speed",
   Range = {20,300},
   Increment = 10,
   CurrentValue = flySpeed,
   Callback = function(v)
      flySpeed = v
   end
})

-- ================= WARP =================
local WarpTab = Window:CreateTab("🧍 Warp")

for _,plr in pairs(Players:GetPlayers()) do
   if plr ~= player then
      WarpTab:CreateButton({
         Name = "Warp to "..plr.Name,
         Callback = function()
            if char and char:FindFirstChild("HumanoidRootPart")
            and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
               char.HumanoidRootPart.CFrame =
               plr.Character.HumanoidRootPart.CFrame * CFrame.new(0,0,-3)
            end
         end
      })
   end
end

-- ================= SETTINGS =================
local SetTab = Window:CreateTab("⚙️ Settings")

SetTab:CreateButton({
   Name = "Destroy UI",
   Callback = function()
      Rayfield:Destroy()
   end
})
